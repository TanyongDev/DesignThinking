{
  "name": "student-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Student portal frontend (Next.js + React + TypeScript + Bootstrap)",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20.9.0",
    "yarn": ">=1.22.0"
  },
  "scripts": {
    "preinstall": "npx --yes only-allow yarn",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "yarn typecheck && yarn lint && yarn format:check",
    "clean": "rm -rf .next tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.3.0",
    "sass": "^1.80.0",
    "typescript": "^5.6.0"
  }
}
